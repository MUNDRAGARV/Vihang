<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wing Macro -->
  <xacro:macro name="wing" params="prefix reflect">
    <link name="${prefix}_wing">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${wing_length} ${wing_width} ${wing_height}"/>
        </geometry>
        <material name="green">
          <color rgba="0 1 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${wing_length} ${wing_width} ${wing_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wing_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${wing_ixx}" ixy="0" ixz="0" iyy="${wing_iyy}" iyz="0" izz="${wing_izz}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wing_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_wing"/>
      <origin xyz="0 ${reflect * wing_offset_y} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- Tilt Motor Macro -->
  <xacro:macro name="tilt_motor" params="prefix wing_prefix x_pos">
    <link name="${prefix}_motor">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${motor_width} ${motor_depth} ${motor_height}"/>
        </geometry>
        <material name="yellow">
          <color rgba="1 1 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${motor_width} ${motor_depth} ${motor_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${motor_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${motor_ixx}" ixy="0" ixz="0" iyy="${motor_iyy}" iyz="0" izz="${motor_izz}"/>
      </inertial>
    </link>

    <joint name="${prefix}_tilt_joint" type="revolute">
      <parent link="${wing_prefix}_wing"/>
      <child link="${prefix}_motor"/>
      <origin xyz="${x_pos} 0 ${motor_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${tilt_limit_lower}" upper="${tilt_limit_upper}" effort="${tilt_effort}" velocity="${tilt_velocity}"/>
    </joint>
  </xacro:macro>

  <!-- Propeller Macro -->
  <xacro:macro name="propeller" params="prefix motor_prefix">
    <link name="${prefix}_prop">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${prop_radius}" length="${prop_thickness}"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="${prop_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${prop_ixx}" ixy="0" ixz="0" iyy="${prop_iyy}" iyz="0" izz="${prop_izz}"/>
      </inertial>
    </link>

    <joint name="${prefix}_prop_joint" type="continuous">
      <parent link="${motor_prefix}_motor"/>
      <child link="${prefix}_prop"/>
      <origin xyz="0 0 ${prop_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- Complete Motor Assembly Macro -->
  <xacro:macro name="motor_assembly" params="prefix wing_prefix x_pos">
    <xacro:tilt_motor prefix="${prefix}" wing_prefix="${wing_prefix}" x_pos="${x_pos}"/>
    <xacro:propeller prefix="${prefix}" motor_prefix="${prefix}"/>
  </xacro:macro>

  <!-- ROS2 Control Macro for Tilt Rotor System -->
  <xacro:macro name="tilt_rotor_ros2_control" params="motor_prefixes">
    <ros2_control name="TiltRotorSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      
      <!-- Iterate through motor prefixes and create controls for each -->
      <xacro:property name="motor_list" value="${motor_prefixes.split(',')}"/>
      <xacro:macro name="create_motor_control" params="motor_prefix">
        <!-- Tilt Joint Control (Position Control) -->
        <joint name="${motor_prefix}_tilt_joint">
          <command_interface name="position">
            <param name="min">${tilt_limit_lower}</param>
            <param name="max">${tilt_limit_upper}</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        
        <!-- Propeller Joint Control (Velocity Control) -->
        <joint name="${motor_prefix}_prop_joint">
          <command_interface name="velocity">
            <param name="min">-100.0</param>  <!-- Max reverse RPM -->
            <param name="max">100.0</param>   <!-- Max forward RPM -->
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
      </xacro:macro>
      
      <!-- Apply control configuration to each motor -->
      <xacro:macro name="apply_controls" params="*motor_list">
        <xacro:if value="${len(motor_list) > 0}">
          <xacro:create_motor_control motor_prefix="${motor_list[0]}"/>
          <xacro:if value="${len(motor_list) > 1}">
            <xacro:apply_controls>
              <xacro:property name="motor_list" value="${motor_list[1:]}"/>
            </xacro:apply_controls>
          </xacro:if>
        </xacro:if>
      </xacro:macro>
      
      <!-- Manual definition for common tilt rotor configurations -->
      <!-- You'll need to uncomment and modify based on your specific motor setup -->
      <!--
      <xacro:create_motor_control motor_prefix="front_left"/>
      <xacro:create_motor_control motor_prefix="front_right"/>
      <xacro:create_motor_control motor_prefix="rear_left"/>
      <xacro:create_motor_control motor_prefix="rear_right"/>
      -->
    </ros2_control>
    
    <!-- Gazebo ROS2 Control Plugin -->
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(find tilt_drone)/config/tilt_rotor_controllers.yaml</parameters>
        <control_period>0.01</control_period> <!-- 100Hz -->
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Simplified ROS2 Control Macro for specific motors -->
  <xacro:macro name="simple_tilt_rotor_control" params="motor1 motor2 motor3 motor4">
    <ros2_control name="TiltRotorSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      
      <!-- Motor 1 Controls -->
      <joint name="${motor1}_tilt_joint">
        <command_interface name="position">
          <param name="min">${tilt_limit_lower}</param>
          <param name="max">${tilt_limit_upper}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${motor1}_prop_joint">
        <command_interface name="velocity">
          <param name="min">-100.0</param>
          <param name="max">100.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      
      <!-- Motor 2 Controls -->
      <joint name="${motor2}_tilt_joint">
        <command_interface name="position">
          <param name="min">${tilt_limit_lower}</param>
          <param name="max">${tilt_limit_upper}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${motor2}_prop_joint">
        <command_interface name="velocity">
          <param name="min">-100.0</param>
          <param name="max">100.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      
      <!-- Motor 3 Controls -->
      <joint name="${motor3}_tilt_joint">
        <command_interface name="position">
          <param name="min">${tilt_limit_lower}</param>
          <param name="max">${tilt_limit_upper}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${motor3}_prop_joint">
        <command_interface name="velocity">
          <param name="min">-100.0</param>
          <param name="max">100.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      
      <!-- Motor 4 Controls -->
      <joint name="${motor4}_tilt_joint">
        <command_interface name="position">
          <param name="min">${tilt_limit_lower}</param>
          <param name="max">${tilt_limit_upper}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${motor4}_prop_joint">
        <command_interface name="velocity">
          <param name="min">-100.0</param>
          <param name="max">100.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>
    
    <!-- Gazebo ROS2 Control Plugin -->
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(find tilt_drone)/config/tilt_rotor_controllers.yaml</parameters>
        <control_period>0.01</control_period>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
